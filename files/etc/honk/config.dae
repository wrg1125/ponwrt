# honk 配置（PonWrt XG2010G，随固件打包；官方 honk-core 只认 # 注释）
# 文档: https://github.com/daeuniverse/honk/blob/main/doc/en/configuration.md
#
# 本文件默认全直连：先在 LuCI「服务 → honk」或 doona 面板（http://<路由IP>:9527/）
# 里填 node / group、再改 routing，才会真正走代理。
#
# 实测踩过的坑：
#   1. XHTTP 节点必须 alpn=h2（写 h2,http/1.1 会被丢弃）
#   2. 组策略写 min_moving_avg / score / select；写 url_test 会静默降级成 select
#   3. nfqueue_enable 默认 true，会和同命名空间的防火墙抢队列表；本固件保持关闭
#   4. routing 的目标必须是 group，写 node 名会报 unknown-routing-target
#   5. 官方构建不认 // 注释，整个文件会被判 unknown-statement

global {
	wan_interface: auto
	lan_interface: br-lan
	log_level: info
	dial_mode: domain
	auto_config_kernel_parameter: true
	nfqueue_enable: false
	data_dir: '/etc/honk/data'
	tcp_check_url: 'https://www.gstatic.com/generate_204'
	tcp_check_http_method: HEAD
	udp_check_dns: 'dns.google.com:53,8.8.8.8'
	check_interval: 300s
	check_tolerance: 30ms
}

# node {
#     zgo: 'hysteria2://PASSWORD@d.5760576.xyz:443/?sni=d.5760576.xyz'
#     xhttp: 'vless://UUID@d.5760576.xyz:8443?security=tls&type=xhttp&path=/stream&mode=auto&sni=d.5760576.xyz&alpn=h2'
# }
#
# group {
#     proxy {
#         filter: name(zgo, xhttp)
#         policy: min_moving_avg
#         tolerance: 50
#     }
# }

routing {
	pname(honk) -> direct
	dip(geoip:private) -> direct
	dip(geoip:cn) -> direct
	fallback: direct
}

experimental {
	# Clash 兼容 API（只在本机回环）
	clash_api {
		external_controller: '127.0.0.1:9090'
		default_mode: 'Rule'
	}
	# doona 网页面板：http://<路由IP>:9527/ ，首次访问创建管理员
	native_api {
		enabled: true
		listen: '0.0.0.0:9527'
		password_auth: true
		config_write: true
		ui: 'embedded'
	}
	cache_file {
		enabled: true
	}
}
