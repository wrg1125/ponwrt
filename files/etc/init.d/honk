#!/bin/sh /etc/rc.common
# honk 服务控制（默认不启用：/etc/init.d/honk enable && /etc/init.d/honk start）
START=99
STOP=10
USE_PROCD=1

start_service() {
	config_load honk 2>/dev/null || true

	procd_open_instance
	# geo 数据来自 v2ray-geosite / v2ray-geoip
	procd_set_param env DAE_LOCATION_ASSET=/usr/share/v2ray
	procd_set_param command /usr/bin/honk -c /etc/honk/config.dae --data-dir /etc/honk
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "honk"
}
